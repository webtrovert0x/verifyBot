# ==========================================
# VerifyBOT Environment Variables Template
# ==========================================

# 1. Bohr Chain Private Key (for deploying contracts and backend oracle reporting)
PRIVATE_KEY=your_private_key_here

# 2. Reown (WalletConnect) Project ID
REOWN_PROJECT_ID=your_reown_project_id_here
PROJECT_ID=your_reown_project_id_here

# 3. Bohr Network Configuration
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968
EXPLORER_URL=https://scan.bohr.life

# 4. Deployed VerifyBOTRegistry Contract Address
CONTRACT_ADDRESS=0xBFCDDC2F013106eE4e882d6C5DD10409d00E76e3
